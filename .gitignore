.pio
.idea
.travis.yml

# Ignore everything under .vscode/ except settings.json: the rest
# (c_cpp_properties.json, extensions.json, launch.json) is PlatformIO's
# auto-generated, machine-specific IDE config; settings.json here is the
# hand-written cmake.buildDirectory override, worth sharing.
.vscode/*
!.vscode/settings.json

cmake-*
test/cmake-*
